{
  "name": "web-portfolio",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "db:generate:sqlite": "drizzle-kit generate:sqlite --config ./drizzle.sqlite.config.ts",
    "db:migration:run:sqlite": "tsx ./app/db/sqlite/migrator.server.ts",
    "dev": "react-router dev",
    "format": "prettier --write .",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint --fix",
      "prettier --write"
    ]
